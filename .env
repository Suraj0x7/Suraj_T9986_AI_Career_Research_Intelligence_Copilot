# =========================
# Application Environment
# =========================
ENVIRONMENT=development
PROJECT_NAME="AI Career & Research Copilot"


# =========================
# PostgreSQL Database
# =========================
# IMPORTANT:
# "postgres" = Docker Compose service name
# 5432 = PostgreSQL port INSIDE Docker
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/career_copilot


# =========================
# JWT Security
# =========================
SECRET_KEY=career_copilot_super_secret_key_change_this_9823472938472938472394723984
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# =========================
# Google Gemini API
# =========================
GOOGLE_API_KEY=AIzaSyBgJQkrbYcyTg4vvZqZcsdrjYGzTbBt4Zc


# =========================
# YouTube Data API v3
# Optional
# =========================
YOUTUBE_API_KEY=


# =========================
# ChromaDB
# =========================
# IMPORTANT:
# "chromadb" = Docker Compose service name
# 8000 = Chroma port INSIDE Docker
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# This may be unused when running Chroma as its own Docker service.
CHROMA_PERSIST_DIRECTORY=./chroma_db


# =========================
# Frontend
# =========================
NEXT_PUBLIC_API_URL=http://localhost:8000