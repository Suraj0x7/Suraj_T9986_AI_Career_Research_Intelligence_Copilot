# ================================================================
# AI CAREER & RESEARCH COPILOT - ENVIRONMENT CONFIGURATION
# ================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI Career & Research Copilot"

# Database Configuration (PostgreSQL in production/Docker, SQLite auto-fallback in local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_copilot

# JWT Security
SECRET_KEY=supersecretjwtkey_change_in_production_893247923487293847923
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (For Resume RAG, Research Decomposition, Interview Prep)
# Get a key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 (Optional: fallback curated search URLs used if not configured)
# Get a key from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_optional

# ChromaDB Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
